{
  "name": "@kestrel/context-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first code context engine with SQLite-backed vector retrieval and MCP tools.",
  "bin": {
    "context-engine": "./bin/context-engine.js",
    "context-engine-mcp": "./bin/context-engine-mcp.js"
  },
  "scripts": {
    "test": "node --test",
    "smoke": "node ./bin/context-engine.js index ./tests/fixtures/sample-repo --db ./.tmp/sample.ctx.db && node ./bin/context-engine.js search \"where is auth handled\" --db ./.tmp/sample.ctx.db --limit 3",
    "eval": "node ./bin/context-engine.js eval ./tests/fixtures/sample-repo --db ./.tmp/golden-eval.ctx.db --limit 3",
    "eval:self": "node ./bin/context-engine.js eval . --db ./.tmp/self-golden-eval.ctx.db --limit 8 --suite self",
    "eval:self:ollama": "node ./bin/context-engine.js eval . --db ./.tmp/self-golden-eval.ollama.ctx.db --limit 8 --suite self --embedding-provider ollama --embedding-model ${CONTEXT_ENGINE_OLLAMA_MODEL:-nomic-embed-text} --embedding-dims ${CONTEXT_ENGINE_OLLAMA_DIMS:-768}"
  },
  "dependencies": {
    "@babel/parser": "^7.29.7",
    "@modelcontextprotocol/sdk": "1.29.0",
    "tree-sitter": "^0.21.1",
    "tree-sitter-javascript": "^0.23.1",
    "tree-sitter-typescript": "^0.23.2",
    "zod": "4.4.3"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
